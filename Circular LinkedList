class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class CircularLinkedList:
    def __init__(self):
        self.head = None

    def is_empty(self):
        return self.head is None

    def append(self, data):
        """Add a node to the end of the circular list."""
        new_node = Node(data)
        if self.is_empty():
            self.head = new_node
            new_node.next = self.head
            return
        
        # Traverse to the last node
        temp = self.head
        while temp.next != self.head:
            temp = temp.next
        
        temp.next = new_node
        new_node.next = self.head

    def prepend(self, data):
        """Add a node to the beginning of the circular list."""
        new_node = Node(data)
        if self.is_empty():
            self.head = new_node
            new_node.next = self.head
            return
        
        # Find the last node to update its next pointer
        temp = self.head
        while temp.next != self.head:
            temp = temp.next
            
        temp.next = new_node
        new_node.next = self.head
        self.head = new_node  # Move head to the new node

    def delete(self, key):
        """Delete a node containing the specified data."""
        if self.is_empty():
            print("List is empty")
            return

        # Case 1: The list has only one node
        if self.head.next == self.head:
            if self.head.data == key:
                self.head = None
            return

        # Case 2: The node to delete is the head
        if self.head.data == key:
            # Find the last node to update its pointer
            temp = self.head
            while temp.next != self.head:
                temp = temp.next
            temp.next = self.head.next
            self.head = self.head.next
            return

        # Case 3: The node is somewhere in the middle or end
        curr = self.head
        prev = None
        while curr.next != self.head:
            prev = curr
            curr = curr.next
            if curr.data == key:
                prev.next = curr.next
                return
        
        print(f"Node with data {key} not found")

    def display(self):
        """Display the elements of the circular linked list."""
        if self.is_empty():
            print("List is empty")
            return
        
        temp = self.head
        nodes = []
        while True:
            nodes.append(str(temp.data))
            temp = temp.next
            if temp == self.head:
                break
        
        # Visual representation indicating the circular nature
        print(" -> ".join(nodes) + " -> (back to head: " + str(self.head.data) + ")")
